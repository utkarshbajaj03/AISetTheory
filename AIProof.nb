  3.9670317883292847`*^9, 3.967031946634658*^9}, {3.967031982787345*^9, 
  3.967032030707347*^9}, {3.967032290954795*^9, 3.967032415686865*^9}, {
  3.967032456734853*^9, 3.967032503237895*^9}, {3.967033768566349*^9, 
  3.967033808132275*^9}, {3.967508870081457*^9, 3.967508874031052*^9}, {
  3.967508966517735*^9, 3.9675090806352053`*^9}, {3.967509189413134*^9, 
  3.967509230182474*^9}, {3.967509269053655*^9, 3.9675093207763247`*^9}, {
  3.967509413632942*^9, 
  3.967509426966749*^9}},ExpressionUUID->"a17dba8d-b8e6-4618-b30d-\
230878ddf2e4"]
