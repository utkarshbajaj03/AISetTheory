Cell["\<\
now we take take this thing.. the pgroup isomorphism problem. \
\>", "Text",
 CellChangeTimes->{{3.9699482214936533`*^9, 3.969948259221229*^9}, {
  3.969948559185158*^9, 
  3.969948575271954*^9}},ExpressionUUID->"d68465a5-19f1-4977-b785-\
15d9201263f2"],

Cell["\<\
 Logic in computer science; linear dynamical systems; automated verification.\
\
\>", "Text",
 CellChangeTimes->{{3.970115336627089*^9, 
  3.970115339166505*^9}},ExpressionUUID->"b99009d7-6529-4468-8762-\
8d2cca2b0368"],

Cell[TextData[{
 StyleBox["James Benjamin Worrel",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox["-", TraditionalForm]],ExpressionUUID->
  "00b2d79b-a699-4a1e-a93c-ea547f333254"],
 "  AI",
 Cell[BoxData[
  FormBox["-", TraditionalForm]],ExpressionUUID->
  "45d9b741-da2e-4408-8639-5ada5d836d68"],
 "assisted mathematics thing (CS dept.). We can talk about the recursion \
project. I\[CloseCurlyQuote]ll send him an email. Supervision request. \n\
Support vector machine with algebraic structures and. "
}], "Text",
 CellChangeTimes->{{3.969949258800061*^9, 3.9699493864339237`*^9}, {
  3.96994944352386*^9, 3.969949492999786*^9}, {3.9699496021421003`*^9, 
  3.969949602310517*^9}},ExpressionUUID->"eda07ca3-31ad-4dc0-af78-\
d0135d9438b8"],

Cell[TextData[StyleBox["Ruben college PhD students. Train PhD STUDENTs to be \
affiliated with AI. It\[CloseCurlyQuote]s a college with a pure CS PhD \
program type program. Isn\[CloseCurlyQuote]t that just type shit? Maybe there \
is the CDT in machine learning etc. stuff going on here.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.969949606774289*^9, 3.9699496577248893`*^9}, {
