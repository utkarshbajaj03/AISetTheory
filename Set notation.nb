Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold"],
 " (Raw input). The raw input to the math agent will be just mathematical \
objects from lean. The tokens will consist of the alphabet, containing the \
quantifiers, logical connectives, just like how a first order language is \
defined."
}], "Item",
 CellChangeTimes->{{3.969588195205944*^9, 
  3.969588288613118*^9}},ExpressionUUID->"8cc5e295-4226-48ff-aeba-\
d58932711374"],

Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" (Emotional response). This has to do with some sort of \
reinforcement learning. It would be nice to learn about this.",
  FontSlant->"Italic"]
}], "Item",
 InitializationCell->True,
 CellChangeTimes->{{3.968925057353464*^9, 3.968925075433436*^9}, {
