Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold"],
 " (Subconscious mind). It consists of an embedding/representation of \
knowledge. It is a physical process, with forces of attraction/repulsion \
based on chemical reactions. It is the ",
 StyleBox["physical process ",
  FontSlant->"Italic"],
 "underlying what happens in the lower layers."
}], "Item",
 InitializationCell->True,
 CellChangeTimes->{{3.968925057353464*^9, 3.968925075433436*^9}, {
   3.96892550260637*^9, 3.968925554223379*^9}, {3.968925631851144*^9, 
