Cell[TextData[{
 StyleBox["Note.",
  FontWeight->"Bold"],
 " Understanding mathematics requires some background knowledge. For \
instance, it would be hopeless to teach babies about mathematics because \
there is language. Also, basic \[OpenCurlyDoubleQuote]ideas\
\[CloseCurlyDoubleQuote] like small/big are alien to them but are useful in \
understanding mathematics. Thus, what are some other easy representations we \
can use? Maybe we can use English text."
}], "Item",
 InitializationCell->True,
 CellChangeTimes->{{3.968925057353464*^9, 3.968925075433436*^9}, {
   3.96892550260637*^9, 3.968925554223379*^9}, {3.968925631851144*^9, 
   3.968925706119936*^9}, {3.968925750384704*^9, 3.968925752223277*^9}, {
   3.968925874939961*^9, 3.96892588735154*^9}, {3.968925934511079*^9, 
   3.968925955214978*^9}, {3.968925993597217*^9, 3.968925994919438*^9}, {
   3.968926043449174*^9, 3.968926120834743*^9}, {3.969177336302785*^9, 
   3.9691773373210382`*^9}, {3.9694178781497*^9, 3.969417887555483*^9}, {
   3.969417950005468*^9, 3.969418001094521*^9}, {3.969418199650055*^9, 
   3.969418201340248*^9}, 3.969458690587567*^9, {3.969588315256201*^9, 
