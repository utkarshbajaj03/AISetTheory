Cell[TextData[{
 StyleBox["Example.",
  FontWeight->"Bold"],
 " If the input is ",
 Cell[BoxData[
  FormBox["\"\<A set\>\"", TraditionalForm]],ExpressionUUID->
  "564e5fa8-4515-414d-8155-58fcf8e41979"],
 ", then the output is a vertex \[OpenCurlyDoubleQuote]set\
\[CloseCurlyDoubleQuote] with a dangling edge. And then when we say it is a \
collection of edges, there is a directed edge from \[OpenCurlyDoubleQuote]set\
\[CloseCurlyDoubleQuote] to the node in the lower layer, which is \
\[OpenCurlyDoubleQuote]collection of objects\[CloseCurlyDoubleQuote]. "
}], "Item",
